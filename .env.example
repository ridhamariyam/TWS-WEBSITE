# Copy to .env.local for local use; configure these in your deployment too.
# Keep the holding page live until the studio is ready to launch.
SITE_LAUNCHED=false

# Recipient is fixed to thewebstudioagency@gmail.com in src/lib/site-links.ts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=thewebstudioagency@gmail.com
# Use a Google App Password, not your Google account password.
SMTP_PASSWORD=
